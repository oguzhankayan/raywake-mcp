{
  "name": "@raywake/mcp",
  "version": "0.2.0",
  "description": "500+ AI image, video and audio models in Claude, ChatGPT, Cursor and any MCP client.",
  "type": "module",
  "bin": {
    "raywake-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Raywake",
  "repository": {
    "type": "git",
    "url": "https://github.com/oguzhankayan/raywake-mcp.git"
  },
  "homepage": "https://raywake.si",
  "mcpName": "si.raywake/mcp",
  "keywords": [
    "raywake",
    "mcp",
    "ai",
    "image",
    "video",
    "audio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/make-executable.mjs",
    "test": "npm run build && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
